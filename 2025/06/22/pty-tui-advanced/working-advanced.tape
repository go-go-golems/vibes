Output working-advanced-tui.gif

Set Shell bash
Set FontSize 14
Set Width 1200
Set Height 800
Set Theme "Dracula"

# Navigate and start
Type "cd /home/ubuntu/pty-tui-advanced && ./enhanced-pty-tui"
Enter
Sleep 4s

# Size preset 1 (tiny)
Type "1"
Sleep 2s

# Size preset 3 (medium)  
Type "3"
Sleep 2s

# Size preset 5 (large)
Type "5"
Sleep 2s

# Send command
Type "c"
Sleep 2s

# Change border
Type "b"
Sleep 1s

# Change theme
Type "t"
Sleep 1s

# Manual resize
Type "r"
Sleep 2s

# Exit
Type "q"
Sleep 1s

