# Pelican Farm Management System Environment Configuration
# Copy this file to .env and configure for your environment

# Application Configuration
APP_NAME=pelican-farm
ENVIRONMENT=development
PORT=8080
LOG_LEVEL=info

# Database Configuration
DB_PATH=./pelican_farm.db

# Gin Framework Configuration
GIN_MODE=debug

# Security Configuration (generate secure random strings)
SESSION_SECRET=your-secure-session-secret-here
JWT_SECRET=your-secure-jwt-secret-here

# Redis Configuration (for agentbus)
REDIS_URL=redis://localhost:6379

# AgentBus Configuration
AGENT_ID=pelican-farm-server
PROJECT_PREFIX=pelican-farm

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9090

# SSL Configuration (for production)
SSL_CERT_PATH=/etc/ssl/certs/pelican-farm.crt
SSL_KEY_PATH=/etc/ssl/private/pelican-farm.key

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *

# Rate Limiting
API_RATE_LIMIT=100
WEB_RATE_LIMIT=1000

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s

# Production overrides (uncomment for production)
# ENVIRONMENT=production
# GIN_MODE=release
# LOG_LEVEL=warn
# DB_PATH=/app/data/pelican_farm.db
