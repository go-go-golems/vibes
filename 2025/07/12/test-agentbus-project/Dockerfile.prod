# Production-optimized Docker build
FROM golang:1.21-alpine AS builder

# Security: Run as non-root user
RUN adduser -D -s /bin/sh appuser

# Install build dependencies
RUN apk add --no-cache git ca-certificates gcc musl-dev sqlite-dev

WORKDIR /app

# Copy dependency files
COPY go.mod go.sum ./

# Download dependencies with verification
RUN go mod download && go mod verify

# Copy source code
COPY . .

# Build with optimizations and security flags
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build \
    -ldflags='-w -s -extldflags "-static"' \
    -a -installsuffix cgo \
    -o server ./cmd/server

# Final production image
FROM alpine:3.18

# Security updates and required packages
RUN apk --no-cache update && \
    apk --no-cache add ca-certificates sqlite tzdata wget && \
    rm -rf /var/cache/apk/*

# Create non-root user
RUN adduser -D -s /bin/sh appuser

# Create app directory and set permissions
WORKDIR /app
RUN chown appuser:appuser /app

# Copy application files
COPY --from=builder --chown=appuser:appuser /app/server ./
COPY --chown=appuser:appuser templates/ templates/
COPY --chown=appuser:appuser static/ static/

# Create directories with proper permissions
RUN mkdir -p /app/data /app/logs && \
    chown -R appuser:appuser /app/data /app/logs

# Switch to non-root user
USER appuser

# Create volumes for data persistence
VOLUME ["/app/data", "/app/logs"]

# Expose port
EXPOSE 8080

# Health check with improved reliability
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/api/v1/pelicans/stats || exit 1

# Run application
CMD ["./server"]
