Output export-demo.gif
Output export-demo.png

Set FontSize 14
Set Width 1200
Set Height 800
Set Theme "Catppuccin Frappe"

Type "cd /home/ubuntu/pixel-tui && ./pixel-tui-export"
Enter
Sleep 2s

# Show first image and export
Type "1"
Sleep 1s
Type "s"
Sleep 1s

# Show second image and export
Type "2" 
Sleep 1s
Type "s"
Sleep 1s

# Show third image and export
Type "3"
Sleep 1s
Type "s"
Sleep 1s

# Show fourth image and export  
Type "4"
Sleep 1s
Type "s"
Sleep 1s

# Enter animation mode and export frame
Type "a"
Sleep 2s
Type "s"
Sleep 1s

# Exit animation and quit
Type "a"
Sleep 1s
Type "q"
Sleep 1s

