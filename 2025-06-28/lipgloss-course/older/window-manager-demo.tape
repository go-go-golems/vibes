Output window-manager-demo.gif
Screenshot window-manager-start.ansi

Set FontSize 12
Set Width 1400
Set Height 1000
Set Theme "Dracula"

Type "cd /home/ubuntu/lipgloss-course/window-manager"
Enter
Sleep 1s

Type "echo 'Running Window Manager Demo...'"
Enter
Sleep 1s

Type "go run combined.go"
Enter
Sleep 2s

Screenshot window-manager-basic.ansi
Sleep 3s

# Let it continue through the demo
Sleep 8s

Screenshot window-manager-overlapping.ansi
Sleep 3s

# Continue through more of the demo
Sleep 10s

Screenshot window-manager-final.ansi
Sleep 2s

