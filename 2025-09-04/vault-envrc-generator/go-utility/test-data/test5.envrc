# Custom .envrc template
# Generated from Vault secrets
# Template: custom-template.tmpl


# Setting UPPER_CASE_KEY
export UPPER_CASE_KEY="upper case value"

# Setting boolean_value
export boolean_value="true"

# Setting empty_value
export empty_value=""

# Setting multiline_value
export multiline_value="line1\nline2\nline3"

# Setting number_value
export number_value="42"

# Setting quotes_value
export quotes_value="value with "quotes" inside"

# Setting spaces_value
export spaces_value="value with spaces"

# Setting special-chars-key
export special-chars-key="special value"


# Additional custom configuration
export TEMPLATE_USED="custom-template.tmpl"
export GENERATED_AT="$(date)"

