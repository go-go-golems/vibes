package cmd

import (
	"context"
	"fmt"

	"keyring/pkg/keyring"

	"github.com/go-go-golems/glazed/pkg/cli"
	"github.com/go-go-golems/glazed/pkg/cmds"
	"github.com/go-go-golems/glazed/pkg/cmds/layers"
	"github.com/go-go-golems/glazed/pkg/cmds/parameters"
	"github.com/go-go-golems/glazed/pkg/middlewares"
	"github.com/go-go-golems/glazed/pkg/settings"
	"github.com/go-go-golems/glazed/pkg/types"
)

type DeleteCommand struct {
	*cmds.CommandDescription
	ring *keyring.Ring
}

type DeleteSettings struct {
	Path    string `glazed.parameter:"path"`
	Profile string `glazed.parameter:"profile"`
}

func NewDeleteCommand(ring *keyring.Ring) (*DeleteCommand, error) {
	glazedLayer, err := settings.NewGlazedParameterLayers()
	if err != nil {
		return nil, err
	}

	commandSettingsLayer, err := cli.NewCommandSettingsLayer()
	if err != nil {
		return nil, err
	}

	cmdDesc := cmds.NewCommandDescription(
		"delete",
		cmds.WithShort("Delete a secret from the keyring"),
		cmds.WithLong(`
Delete a secret from the keyring at the specified hierarchical path.

The secret will be removed from the configured writer backend under the
active profile (or specified profile). This operation is irreversible.

Note: This only removes the secret from the writer backend. If the secret
exists in read-only backends (like environment variables), it may still
be accessible. Use the 'invalidate' command to prevent access across all
backends.

Examples:
  keyring delete --path openai/api_key
  keyring delete --path aws/access_key --profile work
  keyring delete --path temp/token
		`),

		cmds.WithFlags(
			parameters.NewParameterDefinition(
				"path",
				parameters.ParameterTypeString,
				parameters.WithHelp("Hierarchical path to the secret (e.g., openai/api_key)"),
				parameters.WithShortFlag("p"),
				parameters.WithRequired(true),
			),
			parameters.NewParameterDefinition(
				"profile",
				parameters.ParameterTypeString,
				parameters.WithDefault(""),
				parameters.WithHelp("Profile to delete from (defaults to first configured profile)"),
			),
		),

		cmds.WithLayersList(glazedLayer, commandSettingsLayer),
	)

	return &DeleteCommand{
		CommandDescription: cmdDesc,
		ring:               ring,
	}, nil
}

func (c *DeleteCommand) RunIntoGlazeProcessor(
	ctx context.Context,
	parsedLayers *layers.ParsedLayers,
	gp middlewares.Processor,
) error {
	settings := &DeleteSettings{}
	if err := parsedLayers.InitializeStruct(layers.DefaultSlug, settings); err != nil {
		return err
	}

	path := keyring.P(settings.Path)

	// If specific profile requested, temporarily override ring profiles
	originalRing := c.ring
	if settings.Profile != "" {
		c.ring = keyring.New(
			keyring.WithProfiles(settings.Profile),
			keyring.WithReaders(originalRing.GetReaders()...),
			keyring.WithWriter(originalRing.GetWriter()),
			keyring.WithStateStore(originalRing.GetStateStore()),
			keyring.WithAuditSink(originalRing.GetAuditSink()),
			keyring.WithActor(originalRing.GetActor()),
		)
	}

	if err := c.ring.Delete(ctx, path); err != nil {
		if keyring.IsNotFound(err) {
			return fmt.Errorf("secret not found at path: %s", settings.Path)
		}
		if keyring.IsReadOnly(err) {
			return fmt.Errorf("no writer backend configured")
		}
		return fmt.Errorf("failed to delete secret: %w", err)
	}

	// Create output row
	row := types.NewRow(
		types.MRP("path", settings.Path),
		types.MRP("status", "deleted"),
		types.MRP("profile", func() string {
			if settings.Profile != "" {
				return settings.Profile
			}
			return c.ring.GetProfiles()[0]
		}()),
	)

	return gp.AddRow(ctx, row)
}

