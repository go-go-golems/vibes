Set Shell "bash"
Set FontSize 14
Set Width 120
Set Height 120

Type "cd /home/ubuntu/graph-generator"
Enter
Sleep 1s

Type "./graph-generator"
Enter
Sleep 3s

# Main menu
Sleep 2s

# Select first item
Enter
Sleep 2s

# Generate diagram
Ctrl+G
Sleep 4s

# Go back
Type "q"
Sleep 1s

# Select network
Type "j"
Sleep 500ms
Enter
Sleep 2s

# Generate network
Ctrl+G
Sleep 4s

# Exit
Type "q"
Sleep 1s
Type "q"
Sleep 1s

