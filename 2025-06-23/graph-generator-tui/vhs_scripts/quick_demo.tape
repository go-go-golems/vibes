Set Shell "bash"
Set FontSize 12
Set Width 120
Set Height 120
Set PlaybackSpeed 1.5

# Quick demo showing the main features
Type "cd /home/ubuntu/graph-generator && ./graph-generator"
Enter
Sleep 2s

# Show menu
Sleep 1s

# Select organizational chart
Enter
Sleep 1s

# Generate diagram quickly
Ctrl+G
Sleep 2s

# Go back
Type "q"
Sleep 1s

# Select network topology
Type "j"
Sleep 300ms
Enter
Sleep 1s

# Generate network diagram
Ctrl+G
Sleep 2s

# Exit
Type "q"
Sleep 500ms
Type "q"
Sleep 1s

