Output demo-filters.gif

Set FontSize 14
Set Width 1200
Set Height 800

Type "cd /home/ubuntu/conversation-manager"
Enter
Sleep 1s

Type "./conversation-manager"
Enter
Sleep 2s

# Open filters
Type "f"
Sleep 2s

# Navigate filter categories
Type "l"
Sleep 1s
Type "l"
Sleep 1s

# Go back to date filters
Type "h"
Sleep 1s
Type "h"
Sleep 1s

# Select a date filter
Type "j"
Sleep 1s
Type " "
Sleep 2s

# Move to tag filters
Type "l"
Sleep 1s

# Select a tag filter
Type "j"
Sleep 1s
Type " "
Sleep 2s

# Apply filters
Enter
Sleep 2s

# Clear filters
Type "c"
Sleep 1s

# Close filters
Type "f"
Sleep 1s

# Quit
Type "q"
Sleep 1s

