Output demo-preview.gif

Set FontSize 14
Set Width 1200
Set Height 800

Type "cd /home/ubuntu/conversation-manager"
Enter
Sleep 1s

Type "./conversation-manager"
Enter
Sleep 2s

# Navigate to a conversation
Type "j"
Sleep 1s

# Open preview
Type " "
Sleep 2s

# Scroll in preview
Type "j"
Sleep 1s
Type "j"
Sleep 1s
Type "j"
Sleep 1s

# Scroll back up
Type "k"
Sleep 1s
Type "k"
Sleep 1s

# Close preview
Type " "
Sleep 1s

# Try another conversation
Type "j"
Sleep 1s
Type "j"
Sleep 1s

# Open preview again
Type " "
Sleep 2s

# Close and quit
Type " "
Sleep 1s
Type "q"
Sleep 1s

