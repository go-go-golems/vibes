Output demo-navigation.gif

Set FontSize 14
Set Width 1200
Set Height 800

Type "cd /home/ubuntu/conversation-manager"
Enter
Sleep 1s

Type "./conversation-manager"
Enter
Sleep 2s

# Show the main interface
Sleep 2s

# Navigate down through conversations
Type "j"
Sleep 1s
Type "j"
Sleep 1s
Type "j"
Sleep 1s

# Navigate back up
Type "k"
Sleep 1s
Type "k"
Sleep 1s

# Go to top
Type "g"
Sleep 1s

# Go to bottom
Type "G"
Sleep 1s

# Go back to top
Type "g"
Sleep 1s

# Quit
Type "q"
Sleep 1s

